# Copy to a fixed absolute path shared by both A5 nodes, then replace every
# CHANGE_ME value. The generated role configs source this file.

CODE_ROOT="/root/dsv4-afd-hccl/src"
VENV_ROOT="/root/dsv4-afd-hccl/venv"
VLLM_ROOT="${CODE_ROOT}/vllm-release-v0.23.0"
VLLM_ASCEND_ROOT="${CODE_ROOT}/vllm-ascend-rfc-vllm-cann"
AFD_PLUGIN_ROOT="${CODE_ROOT}/afd-plugin-phase1-a5-dspark-official"

CANN_ROOT="CHANGE_ME_ABSOLUTE_CANN_PATH"
# A5 only pins the absolute CANN path. Keep the version check disabled.
CANN_VERSION=""
ATB_ROOT=""
SOC_VERSION="Ascend950DT_9582"

FLASH_MODEL_PATH="/home/models/DeepSeek-V4-Flash"
DSPARK_MODEL_PATH="/home/models/DeepSeek-V4-Flash-DSpark"
MODEL_QUANTIZATION="auto"
MODEL_BLOCK_SIZE="auto"
MODEL_SAFETENSORS_LOAD_STRATEGY="auto"
KV_CACHE_DTYPE="auto"

VLLM_COMMIT="0fc695fc6d1d82e9a5ac6835ac8e4e1c83703665"
VLLM_ASCEND_COMMIT="3da28f9414583d2d0b672a8f06d1fae142404bda"
# The generator resolves this to the exact local HEAD in every role config.
AFD_PD_COMMIT="auto"
VLLM_ASCEND_WORKTREE_MODE="clean"
ENABLE_BATCH_INVARIANT="0"

PREFILL_IP="CHANGE_ME_PREFILL_IP"
DECODE_IP="CHANGE_ME_DECODE_IP"
NIC_NAME="CHANGE_ME_NIC"
# Use a new directory for every independent cold-start round.
A5_PD_RUN_BASE="CHANGE_ME_RUN_BASE"

MOONCAKE_INSTALL_MODE="existing"
MOONCAKE_VERSION="0.3.9"
MOONCAKE_LIBRARY_DIR=""
# Leave empty for standard-path/ldconfig detection, or set the absolute
# libjemalloc.so.2 path on this node.
MOONCAKE_JEMALLOC=""
# Directory containing ub_endpoint_npu_*.json for the A5 HIXL local endpoint.
ASCEND_LOCAL_COMM_RES_PATH="/etc/hixlep"

PREFILL_API_PORT="8100"
DECODE_API_PORT="8910"
FFN_PROCESS_PORT="8911"
PROXY_PORT="9000"
AFD_PORT="29761"
PREFILL_KV_PORT="30000"
DECODE_KV_PORT="30100"
CONTROL_DATA_PARALLEL_RPC_PORT="29360"
CONTROL_MASTER_PORT="29361"
PREFILL_HCCL_IF_BASE_PORT="50000"
ATTENTION_HCCL_IF_BASE_PORT="51000"
FFN_HCCL_IF_BASE_PORT="52000"
MC_MIN_PRC_PORT="15000"
MC_MAX_PRC_PORT="17000"

MAX_MODEL_LEN="4096"
MAX_NUM_BATCHED_TOKENS="4096"
ATTENTION_MAX_NUM_BATCHED_TOKENS="4096"
FFN_MAX_NUM_BATCHED_TOKENS="4096"
MAX_NUM_SEQS="16"
GPU_MEMORY_UTILIZATION="0.90"
HCCL_BUFFSIZE="2048"
OMP_NUM_THREADS="10"
MODEL_NAME="dsv4-afd"

INSTALL_SYSTEM_PACKAGES="0"
RUN_LOCAL_ROUNDTRIP="1"
ROUNDTRIP_PRODUCER_DEVICE="0"
ROUNDTRIP_CONSUMER_DEVICE="1"
WAIT_READY="1"
STARTUP_TIMEOUT_SECONDS="3600"
STOP_TIMEOUT_SECONDS="300"
FORCE_KILL="0"
ALLOW_NPU_PROCESSES="0"
VALIDATION_ROUNDS="3"
VALIDATION_BATCH_SIZES="1 8 32"
RUN_CANCELLATION_TEST="1"
VLLM_SHUTDOWN_TIMEOUT_SECONDS="20"
ARTIFACT_MAX_BYTES="2097152"
ARTIFACT_LOG_TAIL_BYTES="262144"
PORT_SNAPSHOT_TIMEOUT_SECONDS="10"
