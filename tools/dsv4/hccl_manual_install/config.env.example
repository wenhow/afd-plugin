# Copy this file to config.env and edit every path marked CHANGE_ME.

INSTALL_ROOT="${HOME}/dsv4-afd-hccl"
CODE_ROOT="${INSTALL_ROOT}/src"
VENV_ROOT="${INSTALL_ROOT}/venv"
STATE_ROOT="${INSTALL_ROOT}/state"
LOG_ROOT="${INSTALL_ROOT}/logs"

VLLM_ROOT="${CODE_ROOT}/vllm-release-v0.23.0"
VLLM_ASCEND_ROOT="${CODE_ROOT}/vllm-ascend-rfc-vllm-cann"
AFD_PLUGIN_ROOT="${CODE_ROOT}/afd-plugin"

CANN_ROOT="/CHANGE_ME/cann-9.0.0/cann-9.0.0"
MODEL_PATH="/CHANGE_ME/DeepSeek-V4-Flash-w8a8-mtp"
PYTHON_BIN="python3.12"
SOC_VERSION="ascend910_9362"

# Keep this path free of any CANN toolkit entries. CANN is sourced separately.
SYSTEM_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# Set this only when the selected Python needs a non-system shared-library path.
PYTHON_LIBRARY_PATH=""

NIC_NAME="eth0"
# Empty means: resolve the first IPv4 address on NIC_NAME.
HCCL_IF_IP=""
GLOO_SOCKET_IFNAME="${NIC_NAME}"
HCCL_SOCKET_IFNAME="${NIC_NAME}"

API_HOST="127.0.0.1"
ATTENTION_API_PORT="8910"
FFN_PROCESS_PORT="8911"
AFD_HOST="127.0.0.1"
AFD_PORT="29761"
ATTENTION_HCCL_IF_BASE_PORT="51000"
FFN_HCCL_IF_BASE_PORT="52000"

ATTENTION_RANKS="8"
FFN_RANKS="8"
ATTENTION_DEVICES="0,1,2,3,4,5,6,7"
FFN_DEVICES="8,9,10,11,12,13,14,15"

MAX_MODEL_LEN="4096"
MAX_NUM_BATCHED_TOKENS="1024"
ATTENTION_MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS}"
FFN_MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS}"
MAX_NUM_SEQS="8"
GPU_MEMORY_UTILIZATION="0.90"

# Phase-one TP1 combinations support eager/Graph, U1/U2, and MTP N=1..3.
# MTP_DRAFT_EXECUTION=graph requires EXECUTION_MODE=full-decode-only.
EXECUTION_MODE="full-decode-only"
U_BATCHES="2"
ENABLE_MTP="1"
MTP_NUM_SPECULATIVE_TOKENS="3"
MTP_DRAFT_EXECUTION="graph"
DBO_DECODE_TOKEN_THRESHOLD="2"
DBO_PREFILL_TOKEN_THRESHOLD="12"
MAX_CUDAGRAPH_CAPTURE_SIZE="8"
CUDAGRAPH_CAPTURE_SIZES="1 2 4 8"

OMP_NUM_THREADS="10"
HCCL_BUFFSIZE_ATTENTION="1024"
HCCL_BUFFSIZE_FFN="2048"
HCCL_EXEC_TIMEOUT="0"
VLLM_ENGINE_READY_TIMEOUT_S="18000"

# Source handling. The default slim package downloads all three repositories.
# Use 1 only with a package built explicitly with INCLUDE_SOURCES=1.
USE_BUNDLED_SOURCES="0"
VLLM_GIT_URL="https://github.com/vllm-project/vllm.git"
VLLM_ASCEND_GIT_URL="https://github.com/vllm-project/vllm-ascend.git"
AFD_PLUGIN_GIT_URL="https://github.com/wenhow/afd-plugin.git"
AFD_PLUGIN_REF="${AFD_SOURCE_COMMIT}"
REUSE_SOURCES="0"
USE_AFD_SEED_BUNDLE="0"
AFD_SEED_ROOT=""
AFD_SEED_COMMIT=""

# Python package source. OFFLINE=1 controls wheel installation only; the slim
# package must download Git sources before the offline Python install begins.
OFFLINE="0"
WHEELHOUSE=""
PIP_INDEX_URL=""
PIP_EXTRA_INDEX_URL="https://mirrors.huaweicloud.com/ascend/repos/pypi"
PIP_TRUSTED_HOST=""
REUSE_VENV="0"
INSTALL_PYTHON_DEPS="1"
INSTALL_UPSTREAM_STACK="1"

# HCCL-only does not need afd-plugin CAMP2P custom ops.
AFD_BUILD_ASCEND_OPS="0"

WAIT_READY="1"
STARTUP_TIMEOUT_SECONDS="3600"
STOP_TIMEOUT_SECONDS="180"
FORCE_KILL="0"

# Safety overrides. Keep disabled for phase-one validation.
ALLOW_NON_AARCH64="0"
ALLOW_CANN_VERSION_MISMATCH="0"
ALLOW_NPU_PROCESSES="0"
